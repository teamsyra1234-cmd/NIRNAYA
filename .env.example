# NIRNAYA — Environment Configuration Template
# Copy this file to .env.local for local overrides: cp .env.example .env.local

# Server Port (default: 3000)
PORT=3000
NODE_ENV=development

# Database Configuration (LibSQL / SQLite)
# Defaults to local nirnaya.db file in root. Run `pnpm db:seed` to initialize.
DATABASE_URL=file:nirnaya.db

# Authentication
# Secret used for signing session cookies
SESSION_SECRET=nirnaya-dev-secret-key-change-in-production

# External Data Connectors (Optional / Future production integrations)
# Open Government Data (OGD) Platform India API Key
OGD_API_KEY=

# ISRO Bhuvan Geo-Portal Credentials
BHUVAN_API_KEY=

# TiNAI / DILRMP Restricted Connectors (Approval required)
DILRMP_AUTH_TOKEN=
